{
  "$schema": "./behaviors.schema.json",
  "$comment": "Bundled Clawdlet behavior table. Do not edit: put overrides in %APPDATA%\\Clawdlet\\behaviors.json (tray > Open Config Folder). Weights are in 'legacy roll' units: after the engine decides not to wander, the rest of its roll is spread over the eligible rows, so these values reproduce the original thresholds exactly. Rows with min_idle_level 2 (L2) join the pool once the user has been away for settings.idle_level2_after_s; rows with 'chance' are rolled on their own before the weighted pick. Fidget poses are [[gaze_index, hold_s], ...] on the gaze strip: (dy+1)*3+(dx+1), so 3 left, 4 ahead, 5 right, 7 down, 9 blink.",
  "version": 1,
  "settings": {
    "idle_level2_after_s": 45.0,
    "fidget_interval_s": [4.0, 9.0],
    "mail_away_s": 30.0,
    "alert_escalate_s": 10.0,
    "work": {
      "segment_s": {
        "quiet": [20.0, 40.0],
        "normal": [14.0, 28.0],
        "hyper": [8.0, 16.0]
      },
      "break_s": [2.5, 4.5],
      "heuristic_max_s": 60.0,
      "heuristic_cooldown_s": 90.0,
      "juggle_segment_s": [6.0, 10.0]
    }
  },
  "behaviors": [
    {
      "id": "floor_blob",
      "state": "BLOB",
      "weight": {"quiet": 0.63, "normal": 0.23, "hyper": 0.0},
      "when": {"surface": ["floor"], "not_prev_state": ["BLOB"]},
      "duration_s": [2.5, 4.5],
      "scale_by_rest": true,
      "description": "Melt into a puddle on the floor (never twice in a row)."
    },
    {
      "id": "floor_idle",
      "state": "IDLE",
      "weight": 0.15,
      "when": {"surface": ["floor"]},
      "duration_s": [2.2, 4.0],
      "scale_by_rest": true,
      "description": "Stand and breathe on the floor."
    },
    {
      "id": "perch_blob",
      "state": "BLOB",
      "weight": {"quiet": 0.533, "normal": 0.193, "hyper": 0.0},
      "when": {"surface": ["perch"], "not_prev_state": ["BLOB", "WANDER"]},
      "duration_s": [2.4, 4.2],
      "scale_by_rest": true,
      "description": "Melt on Claude's title bar when a stroll was possible but not chosen."
    },
    {
      "id": "perch_look_down",
      "state": "PERCH_CLAUDE",
      "weight": 0.28,
      "when": {"surface": ["perch"], "not_prev_state": ["WANDER"]},
      "duration_s": [3.0, 5.5],
      "scale_by_rest": true,
      "description": "Sit on the title bar and peek down at the chat."
    },
    {
      "id": "perch_blob_after_stroll",
      "state": "BLOB",
      "weight": 0.72,
      "when": {"surface": ["perch"], "prev_state": ["WANDER"]},
      "duration_s": [2.4, 4.2],
      "scale_by_rest": true,
      "description": "Melt on the title bar after a stroll along it."
    },
    {
      "id": "perch_look_down_after_stroll",
      "state": "PERCH_CLAUDE",
      "weight": 0.28,
      "when": {"surface": ["perch"], "prev_state": ["WANDER"]},
      "duration_s": [3.0, 5.5],
      "scale_by_rest": true,
      "description": "Sit and peek down at the chat after a stroll along the title bar."
    },
    {
      "id": "read_scroll",
      "state": "READ_SCROLL",
      "weight": 0.15,
      "when": {"min_idle_level": 2},
      "duration_s": [5.0, 9.0],
      "scale_by_rest": true,
      "cooldown_s": 40.0,
      "next": [{"id": "polish_claw", "weight": 0.25}],
      "next_mode": "add",
      "description": "Unroll a little scroll and read it (often followed by polishing a claw)."
    },
    {
      "id": "polish_claw",
      "state": "POLISH_CLAW",
      "weight": 0.12,
      "when": {"min_idle_level": 2},
      "duration_s": [3.0, 6.0],
      "scale_by_rest": true,
      "description": "Buff a claw to a shine."
    },
    {
      "id": "dig_sand",
      "state": "DIG_SAND",
      "weight": 0.10,
      "when": {"surface": ["floor"], "min_idle_level": 2},
      "duration_s": [4.0, 7.0],
      "scale_by_rest": true,
      "cooldown_s": 60.0,
      "description": "Dig in the sand on the floor."
    },
    {
      "id": "perch_dangle",
      "state": "PERCH_DANGLE",
      "chance": 0.35,
      "weight": 0.0,
      "when": {"surface": ["perch"], "spot": ["perch_edge"]},
      "duration_s": [4.0, 8.0],
      "scale_by_rest": true,
      "cooldown_s": 30.0,
      "description": "Sit at the end of the title bar, facing out, legs dangling over the edge."
    },
    {
      "id": "perch_peer",
      "state": "PERCH_PEER",
      "chance": 0.25,
      "weight": 0.0,
      "when": {"surface": ["perch"], "cursor_in_window": true},
      "duration_s": [3.0, 6.0],
      "scale_by_rest": true,
      "cooldown_s": 45.0,
      "description": "Lean over the title bar and peer down into the window at the cursor."
    },
    {
      "id": "edge_scratch",
      "state": "WALL_SCRATCH",
      "on": "wall_bump",
      "chance": 0.3,
      "weight": 0.0,
      "duration_s": [1.5, 3.0],
      "scale_by_rest": false,
      "cooldown_s": 20.0,
      "description": "Walked into a screen edge without climbing it: scratch at it, then turn around."
    },
    {
      "id": "window_drum",
      "state": "WALL_SCRATCH",
      "on": "window_side",
      "chance": 0.4,
      "weight": 0.0,
      "duration_s": [1.2, 2.4],
      "scale_by_rest": false,
      "cooldown_s": 60.0,
      "description": "Reached the side of Claude's window: drum on it a little, then climb."
    }
  ],
  "work_breaks": [
    {
      "id": "stretch",
      "state": "WORK_STRETCH",
      "weight": 3.0,
      "duration_s": [2.5, 3.5],
      "cooldown_s": 60.0,
      "description": "Stretch both claws overhead beside the laptop (the strip holds its last, resting frame)."
    },
    {
      "id": "think",
      "state": "WORK_THINK",
      "weight": 4.0,
      "duration_s": [3.0, 5.0],
      "description": "Rest the chin on a claw and ponder, '...' over the head."
    },
    {
      "id": "sip",
      "state": "WORK_SIP",
      "weight": 3.0,
      "duration_s": [2.5, 4.0],
      "cooldown_s": 90.0,
      "description": "Sip from the steaming mug next to the laptop."
    },
    {
      "id": "glance",
      "state": "WORK_GLANCE",
      "weight": 2.0,
      "duration_s": [1.5, 2.5],
      "description": "Look up from the laptop for a moment."
    }
  ],
  "fidgets": [
    {
      "id": "look_left_right",
      "weight": 3.0,
      "poses": [[3, 0.6], [4, 0.25], [5, 0.6], [4, 0.2]],
      "description": "Glance left, then right."
    },
    {
      "id": "blink",
      "weight": 2.0,
      "poses": [[9, 0.14], [4, 0.18], [9, 0.14]],
      "description": "A slow double blink."
    },
    {
      "id": "glance_claude",
      "weight": 2.0,
      "target": "claude_window",
      "hold_s": [0.8, 1.6],
      "when": {"claude_visible": true},
      "description": "Look over at Claude's window (down at it when perched on it)."
    }
  ],
  "entrances": []
}
